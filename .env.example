# Bambu Web Remote needs NO secrets to run. Every variable below is optional.

# Optional. Key used to encrypt the httpOnly session cookie (any long random string).
# If you leave it unset, a random key is generated at build time, so every
# redeploy logs everyone out (a fresh key can't decrypt old cookies). Set it to
# keep sessions across redeploys:   openssl rand -base64 32
# SESSION_SECRET=

# Optional. Show a banner on the login page (e.g. "Self-hosted by the Room 12 makerspace").
# NEXT_PUBLIC_INSTANCE_NOTE=
